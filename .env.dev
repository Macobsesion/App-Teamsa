# Variables de entorno para teamsa-app-dev (DESARROLLO)
# ⚠️  Nunca uses esta config en producción

# Base de datos SEPARADA de producción
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_DB=teamsa_dev
POSTGRES_PASSWORD_FILE=/run/secrets/db-password
POSTGRES_PORT=5432

# JWT/Seguridad (puede ser cualquier valor en dev)
SECRET_KEY=dev_secret_key_no_usar_en_produccion_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: permite localhost en desarrollo
CORS_ALLOW_ORIGINS=https://dev.teamsa.com.mx,http://localhost:8002,http://127.0.0.1:8002

# Entorno de ejecución
# En development las cookies NO requieren secure=True (HTTP)
ENVIRONMENT=development
